# Public production URL. Use the exact Vercel domain, without trailing slash.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# 32+ random characters used to encrypt OAuth refresh tokens.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Supabase persistent backend. The secret key is server-only and must never be exposed in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Zoho OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Optional access-gate code hash. The included default is already configured.
COMPANY_ACCESS_CODE_HASH=
